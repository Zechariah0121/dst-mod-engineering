    {
      "id": "NC-N004-FINAL-05",
      "role": "CORE",
      "title": "来源贡献与撤销粒度",
      "origin_main_candidate_ids": [
        "NC-N004-PROV-04",
        "NC-N004-PROV-08"
      ],
      "origin_dot_coding_ids": [
        "N004-C04"
      ],
      "coding_projection": {
        "trigger": "装备、技能或 buff 共用属性、能力、标签，或代码恢复旧共享标量。",
        "decision": "以实际 API 的 source/key 和能力撤销方法释放自己负责的贡献。",
        "exact_symbols": [
          "SourceModifierList:SetModifier(source,value,key)",
          "SourceModifierList:RemoveModifier(source,key)",
          "SourceModifierList:HasModifier(source,key)",
          "ElectricAttacks:RemoveSource",
          "MoistureImmunity:RemoveSource"
        ],
        "source_facts": [
          {
            "statement": "同 source/key 更新；省略 key 使用 default key。nil/base SetModifier 只移除解析后的 key；HasModifier 无 key 只查 default，RemoveModifier 无 key 删整 source。",
            "evidence_refs": [
              "VANILLA-COMBAT-008#fact[4]",
              "MODTIMER-SML-NEUTRAL"
            ]
          },
          {
            "statement": "实体 source 的 onremove 自动清列表，字符串 source 无该监听；Reset 清全列表。列表可选 base/reducer，不能把默认乘法套到 Health additive。",
            "evidence_refs": [
              "VANILLA-COMBAT-008#fact[4]",
              "MODTIMER-SML-RESET",
              "MODTIMER-SML-REDUCER",
              "NATIVE004-COMBAT-HEALTH-F001"
            ]
          },
          {
            "statement": "ElectricAttacks 的底层自动清 source 未调用其 RemoveSource 空集删组件分支；MoistureImmunity 的 _onremovesource 显式检查空集。共享标签的原版技能示例会检查另一来源仍激活。",
