    {
      "id": "NC-N004-FINAL-03",
      "role": "CORE",
      "title": "Combat 与 Health 的通道、入口和结果",
      "origin_main_candidate_ids": [
        "NC-N004-PROV-01"
      ],
      "origin_dot_coding_ids": [
        "N004-C02"
      ],
      "coding_projection": {
        "trigger": "伤害加成、吸收/减伤、吸血/计分、直接 DoDelta 或生命 setter。",
        "decision": "选择实际伤害通道和接口，并按返回值所属阶段解释结果。",
        "exact_symbols": [
          "Combat:CalcDamage",
          "Combat:GetAttacked",
          "Health:DoDelta",
          "Health:SetVal",
          "Health:SetCurrentHealth",
          "Health:SetPercent",
          "pre_health_setval"
        ],
        "source_facts": [
          {
            "statement": "CalcDamage 的特殊通道没有复用普通伤害全部倍率；DoAttack 的 instancemult 只乘普通 dmg。",
            "evidence_refs": [
              "VANILLA-COMBAT-002#fact[2]",
              "VANILLA-COMBAT-001#fact[3]"
            ]
          },
          {
            "statement": "GetAttacked 对已死 Health 可返回 true；damageresolved 取 DoDelta 返回 amount 的负值。DoDelta 的 gate/redirect 可早返，SetVal 又另行裁剪生命上下界。",
            "evidence_refs": [
              "VANILLA-COMBAT-003#fact[0]",
              "VANILLA-COMBAT-003#fact[3]",
              "NATIVE004-COMBAT-HEALTH-F002",
              "NATIVE004-COMBAT-HEALTH-F005"
            ]
          },
          {
            "statement": "Health 外部吸收与定额减伤是 base=0 的 additive 列表；负 amount 的外部吸收乘 max(1-total,0)，定额减伤要求 afflicter 非 nil。ignore_absorb/ignore_invincible 不跳过 deltamodifierfn 或 per-hit cap。",
            "evidence_refs": [
              "NATIVE004-COMBAT-HEALTH-F001",
              "NATIVE004-COMBAT-HEALTH-F003",
              "NATIVE004-COMBAT-HEALTH-F004"
            ]
          },
          {
            "statement": "pre_health_setval.data.val 未被读回局部 val；SetCurrentHealth 只赋字段，SetVal 不显式发 healthdelta，SetPercent 走 SetVal 后 DoDelta(0)。",
            "evidence_refs": [
              "NATIVE004-COMBAT-HEALTH-F005",
              "NATIVE004-COMBAT-HEALTH-F009"
            ]
          }
        ],
        "inference": [
          {
            "statement": "GetAttacked bool、damageresolved、DoDelta amount、裁剪后的损失和所有同步回调结束后的净生命差是不同口径。",
            "evidence_refs": [
              "VANILLA-COMBAT-003#fact[3]",
              "NATIVE004-COMBAT-HEALTH-F005",
              "NATIVE004-COMBAT-HEALTH-F007"
            ]
          }
        ],
        "recommendation": [
          {
            "statement": "需求依赖攻击归因、装备防御和受击回调时沿相应 Combat 路径；全伤害加成分别处理普通与特殊通道。",
            "condition": "目标是保留这些原版攻击阶段。"
          },
          {
            "statement": "只在需求明确要精确 HP 归因时选择 Reviewer 的采样阶段；不要靠修改 pre_health_setval.data.val 截断伤害。",
            "condition": "统计/奖励依赖具体生命口径，或需要改变 Health 行为。"
          }
        ],
        "unknown": [
          {
            "id": "N004-POLICY-HP",
            "classification": "PROJECT_POLICY_OR_MOD_QA",
            "statement": "统计是否含过量伤害、重定向、反伤或回调治疗由项目决定；远端展示时序与删除后 native handle 安全未证明。"
          }
        ]
      },
