    {
      "id": "NC-N004-FINAL-01",
      "role": "CORE",
      "title": "攻击资格与实际效果入口",
      "origin_main_candidate_ids": [
        "NC-N004-PROV-01",
        "NC-N004-PROV-02"
      ],
      "origin_dot_coding_ids": [
        "N004-C01"
      ],
      "coding_projection": {
        "trigger": "新增直接攻击、弹体伤害、weapon hook、命中附加效果或受击被动。",
        "decision": "分别指定攻击资格、基础结算和附加效果的实际入口。",
        "exact_symbols": [
          "Combat:CanAttack",
          "Combat:TryAttack",
          "Combat:DoAttack",
          "Projectile:Hit",
          "ComplexProjectile:Hit",
          "Weapon:OnAttack"
        ],
        "source_facts": [
          {
            "statement": "TryAttack 通过 CanAttack 后推 doattack；DoAttack 自身用 CanHitTarget，不再检查 CanAttack/InCooldown，并可发射后提前返回。",
            "evidence_refs": [
              "VANILLA-COMBAT-001#fact[0]",
              "VANILLA-COMBAT-001#fact[2]"
            ]
          },
          {
            "statement": "普通 Projectile:Hit 仅对解析到非 nil 且有 combat 的 attacker 调 DoAttack；其后 onhit 可在没有该结算或未命中成功时仍运行。ComplexProjectile:Hit 只 Cancel 并转发 onhitfn。",
            "evidence_refs": [
              "VANILLA-COMBAT-005#fact[2]",
              "VANILLA-COMBAT-007#fact[2]"
            ]
          },
          {
            "statement": "直接 DoAttack 在 GetAttacked 后不检查返回值就调 Weapon:OnAttack；OnAttack 回调、weapononattack 与耐久处理分阶段发生。DoAreaAttack 的 hitcount 在 GetAttacked 后递增，不检查成功。",
            "evidence_refs": [
              "VANILLA-COMBAT-004#fact[0]",
              "VANILLA-COMBAT-004#fact[1]",
              "VANILLA-COMBAT-004#fact[2]",
              "VANILLA-COMBAT-001#fact[4]"
            ]
          }
        ],
        "inference": [
          {
            "statement": "名称为 onhit/onattack 的回调到达不能共同解释成基础伤害成功。",
            "evidence_refs": [
              "VANILLA-COMBAT-005#fact[2]",
              "VANILLA-COMBAT-004#fact[1]",
              "VANILLA-COMBAT-007#fact[2]"
            ]
          }
        ],
        "recommendation": [
          {
            "statement": "保留普通弹体默认结算时，不在其 onhit 再结算同一份基础伤害；复杂弹体按所选 prefab 回调安排实际伤害。",
            "condition": "当前功能沿这些默认分支，且不是有意追加的独立伤害。"
          },
          {
            "statement": "将状态、耐久、FX 和删除按所需触发条件接入；受击连锁只针对实际会递归的调用设置边界。",
            "condition": "项目已经决定零生命损失或连锁时哪些附加效果应发生。"
          }
        ],
        "unknown": [
          {
            "id": "N004-POLICY-ATTACK",
            "classification": "PROJECT_POLICY_OR_MOD_QA",
            "statement": "攻击冷却启动时点、零损失附加效果与允许的连锁由具体 Action/SG/prefab 决定。"
          }
        ]
      },
