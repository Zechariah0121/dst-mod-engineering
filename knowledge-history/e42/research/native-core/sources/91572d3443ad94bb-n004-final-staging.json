    {
      "id": "NC-N004-FINAL-02",
      "role": "CORE",
      "title": "延迟弹体的归因与结束责任",
      "origin_main_candidate_ids": [
        "NC-N004-PROV-03"
      ],
      "origin_dot_coding_ids": [
        "N004-C01"
      ],
      "coding_projection": {
        "trigger": "飞行期间换武器、转交武器、归属实体消失，或 Miss/Cancel 后弹体残留。",
        "decision": "确认默认归因和计算时点是否符合需求，再分别安排停止运动与实体去留。",
        "exact_symbols": [
          "Weapon:LaunchProjectile",
          "Projectile:Throw(owner,target,attacker)",
          "Projectile:Hit",
          "Projectile:Stop",
          "Projectile:Miss",
          "ComplexProjectile:Launch",
          "ComplexProjectile:Cancel"
        ],
        "source_facts": [
          {
            "statement": "普通 Throw 保存 owner/target，没有保存第三参为 self.attacker；LaunchProjectile 以发射武器作 owner。Hit 若 owner 无 combat 而有 weapon/inventoryitem，就取该武器当前 inventoryitem.owner。",
            "evidence_refs": [
              "VANILLA-COMBAT-005#fact[0]",
              "VANILLA-COMBAT-005#fact[1]"
            ]
          },
          {
            "statement": "has_damage_set 且弹体有 weapon 时选弹体作伤害武器，否则选发射武器；进入 DoAttack 后仍在命中时 CalcDamage/GetDamage。",
            "evidence_refs": [
              "VANILLA-COMBAT-005#fact[1]",
              "VANILLA-COMBAT-005#fact[3]"
            ]
          },
          {
            "statement": "普通 Stop 清 owner/target 和更新，未 Physics:Stop/Remove；Miss 先 Stop 再 onmiss，Hit/Catch 额外停物理。复杂 Cancel 停运动但不 Remove，也不清 attacker/owningweapon。",
            "evidence_refs": [
              "VANILLA-COMBAT-006#fact[3]",
              "VANILLA-COMBAT-007#fact[3]"
            ]
          },
          {
            "statement": "ComplexProjectile:Launch 保存 attacker，owningweapon 默认弹体自身，并使用坐标 targetPos；Weapon:onprojectilelaunched 的 proj 参数可能为 nil。",
            "evidence_refs": [
              "VANILLA-COMBAT-007#fact[0]",
              "VANILLA-COMBAT-004#fact[3]"
            ]
          }
        ],
        "inference": [
          {
            "statement": "默认普通弹体使用命中时可解析到的武器/归属和计算状态，发射参数不提供稳定快照。",
            "evidence_refs": [
              "VANILLA-COMBAT-005#fact[0]",
              "VANILLA-COMBAT-005#fact[1]",
              "VANILLA-COMBAT-005#fact[3]"
            ]
          }
        ],
        "recommendation": [
          {
            "statement": "只有需求明确要发射时快照，才另存相应值并定义归属实体失效规则。",
            "condition": "默认命中时语义不符合已决定的归因要求。"
          },
          {
            "statement": "按所选 Hit/Miss/Catch/Cancel 路径决定删除、返航或留地；使用对应回调参数。",
            "condition": "弹体 prefab 需要明确的结束行为。"
          }
        ],
        "unknown": [
          {
            "id": "N004-UNK-PHYSICS",
            "classification": "NATIVE_UNKNOWN",
            "statement": "物理 collision mask、高速/离屏检测与原生 scheduler 的完整互动未由所引 Lua 证明。"
          }
        ]
      },
