    {
      "id": "NC-N004-FINAL-04",
      "role": "CORE",
      "title": "物品位置、转移结果与装备 callback owner",
      "origin_main_candidate_ids": [
        "NC-N004-PROV-04",
        "NC-N004-PROV-05"
      ],
      "origin_dot_coding_ids": [
        "N004-C03"
      ],
      "coding_projection": {
        "trigger": "物品在 pocket/active/equipped/container 间移动，装备转交或奖励满包失败。",
        "decision": "从实际成员位置和直接 owner 选择移交路径；效果撤销使用旧 callback owner。",
        "exact_symbols": [
          "Inventory:SetActiveItem",
          "Inventory:SelectActiveItemFromSlot",
          "Inventory:GiveActiveItem",
          "Inventory:Equip",
          "Inventory:Unequip",
          "InventoryItem:IsHeld",
          "InventoryItem:GetSlotNum",
          "InventoryItem:GetGrandOwner",
          "Container:GiveItem"
        ],
        "source_facts": [
          {
            "statement": "SetActiveItem 的 accepted-item 分支写 active 引用而不移除旧槽或转移 owner；物品不允许入容器的拒收分支调用 DropItem。SelectActiveItemFromSlot 先清 pocket 槽并发 itemlose；GiveActiveItem 在 SetActiveItem 前 OnPutInInventory，函数内没有 RemoveFromOwner。",
            "evidence_refs": [
              "INVACTIVE-F01",
              "INVACTIVE-F02",
              "INVACTIVE-F03",
              "DOT-N004-C03-COMPACT"
            ]
          },
          {
            "statement": "IsHeld 仅检查 owner 非 nil；GetSlotNum 沿直接 owner 的 GetItemSlot，玩家 Inventory:GetItemSlot 只查 pocket；active、equipslots 与 grand owner 分别判断。",
            "evidence_refs": [
              "INVACTIVE-F04",
              "VANILLA-INV-001#fact[4]"
            ]
          },
          {
            "statement": "新装备 onequip 在 equipslots 写入前；成功卸装 onunequip 在清槽前，且 Unequip 本身没有 OnRemoved/ClearOwner。整件非堆叠装备转交先旧 owner 卸装、OnRemoved，再新 owner OnPutInInventory/Equip。",
            "evidence_refs": [
              "VANILLA-INV-003#fact[1]",
              "VANILLA-INV-003#fact[2]",
              "INVACTIVE-F05",
              "INVOWNER-F01",
              "INVOWNER-F02"
            ]
          },
          {
            "statement": "Container:GiveItem=false 可能已部分接收；RemoveItem 返回原实体可表示未找到。OnLoad 通过 GiveItem/Equip 恢复，保存的 activeitem 也走 GiveItem。",
            "evidence_refs": [
              "VANILLA-INV-002#fact[2]",
              "VANILLA-INV-002#fact[3]",
              "VANILLA-INV-002#fact[4]",
              "VANILLA-INV-005#fact[1]"
            ]
          }
        ],
        "inference": [
          {
            "statement": "引用/槽位、直接 owner、外层拥有者与转移返回值不能互相替代。",
            "evidence_refs": [
              "INVACTIVE-F01",
              "INVACTIVE-F04",
              "VANILLA-INV-001#fact[4]",
              "VANILLA-INV-002#fact[4]"
            ]
          }
        ],
        "recommendation": [
          {
            "statement": "使用对应库存/容器移交方法；装备回调清传入旧 owner 的贡献，再向新 owner 安装自身来源效果。",
            "condition": "功能使用这些实际移交分支。"
          },
          {
            "statement": "按仍有效实体的剩余数量、直接 owner 与成员位置处理部分交付，不据 false 补发原数量。",
            "condition": "当前奖励或转移需要数量守恒。"
          }
        ],
        "unknown": [
          {
            "id": "N004-QA-ITEM",
            "classification": "MOD_QA",
            "statement": "自定义回调移动/合并/销毁、堆叠拆分装备及具体部分交付政策须按项目核对。"
          }
        ]
      },
