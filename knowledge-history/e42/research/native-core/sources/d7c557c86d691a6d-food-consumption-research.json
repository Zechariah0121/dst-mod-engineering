  "reviewer_only": {
    "cached_diet_tags_zh": "GetEdibleTags默认缓存派生tags，已存在真值cache直接返回；SetDiet/oncaneat所读路径没有清cache。允许cacheedibletags=false禁缓存；这是按需边界，库存collector本身不用此方法。",
    "cached_diet_citation_ids": [
      "FC-C01",
      "FC-C02",
      "FC-C05"
