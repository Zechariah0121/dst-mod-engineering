  "sample_only": [
    {
      "id": "FC-SAMPLE-CARROT",
      "claim_kind": "SingleOrdinaryFoodConsumer_SourceSampleOnly",
      "only_food": "carrot (fresh normal item, non-quagmire, unmodified eating hooks)",
      "statement_zh": "MakeVegStats映射health/hunger/sanity；carrot生食条目为health=TUNING.HEALING_TINY、hunger=TUNING.CALORIES_SMALL、sanity=0、perishtime=TUNING.PERISH_MED、secondary_foodtype=nil。fresh factory SetPristine之后非mastersim返回；server侧配置edible为VEGGIE与这些stat、perishable、stackable，后续inventoryitem存在。FOODGROUP.OMNI含VEGGIE，故正常默认Eater的类型匹配可接受此food。normal非quagmire且未有其他Mod改写时，所读carrot fresh factory未设置SetOnEatenFn/SetHandleRemoveFn/SetOverrideStackMultiplierFn，默认single consumption沿组件合同；quagmire条件会调用外部master_postinit，不把该特殊模式纳入此默认样本；此样本只证明脚本接线和静态条件，不声称已生成实体、当前状态、实际HP/hunger变化或所有食物相同。",
      "citation_ids": [
        "FC-C01",
        "FC-C09",
        "FC-C10",
        "FC-C17",
        "FC-C21",
        "FC-C22",
        "FC-C23",
