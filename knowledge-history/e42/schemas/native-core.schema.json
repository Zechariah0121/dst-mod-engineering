{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Core Governance 1",
  "type": "object",
  "required": ["schema_version", "version", "state_registry", "entries", "source_artifacts", "historical_product_evidence"],
  "properties": {
    "schema_version": {"const": "native-core-governance/1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "state_registry": {"type": "array", "items": {"$ref": "#/$defs/state"}},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "source_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "historical_product_evidence": {"type": ["array", "object"]}
  },
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "knowledge_status": {"enum": ["research", "supported", "canonical", "corrected", "superseded"]},
    "retrieval_status": {"enum": ["reviewer_default", "task_conditional", "deep_only", "restricted"]},
    "coding_status": {"enum": ["coding_default", "coding_conditional", "hold", "prohibited"]},
    "reference": {
      "type": "object",
      "required": ["artifact_path", "sha256", "pointer"],
      "properties": {
        "artifact_path": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pointer": {"type": "string", "pattern": "^#?/"}
      },
      "additionalProperties": false
    },
    "references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "artifact": {
      "type": "object",
      "required": ["artifact_path", "sha256"],
      "properties": {
        "artifact_path": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pointer": {"type": "string", "pattern": "^#?/"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "state": {
      "type": "object",
      "required": ["id", "knowledge_status", "retrieval_status", "coding_status"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "knowledge_status": {"$ref": "#/$defs/knowledge_status"},
        "retrieval_status": {"$ref": "#/$defs/retrieval_status"},
        "coding_status": {"$ref": "#/$defs/coding_status"}
      }
    },
    "claim": {
      "type": "object",
      "required": ["kind", "statement", "evidence_refs"],
      "properties": {
        "kind": {"enum": ["NSF", "RV", "EI", "REC", "UNK", "PROJECT_POLICY", "HISTORICAL_PRODUCT_EVIDENCE"]},
        "statement": {"$ref": "#/$defs/text"},
        "evidence_refs": {"$ref": "#/$defs/references"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "title", "track", "category", "knowledge_status", "retrieval_status", "coding_status", "scope", "claims", "evidence_refs", "does_not_prove", "aliases", "task_keywords", "historical_status", "correction_refs", "gate_a"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]+$"},
        "title": {"$ref": "#/$defs/text"},
        "track": {"$ref": "#/$defs/text"},
        "category": {"$ref": "#/$defs/text"},
        "knowledge_status": {"$ref": "#/$defs/knowledge_status"},
        "retrieval_status": {"$ref": "#/$defs/retrieval_status"},
        "coding_status": {"$ref": "#/$defs/coding_status"},
        "scope": {"type": "object"},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "evidence_refs": {"$ref": "#/$defs/references"},
        "does_not_prove": {"$ref": "#/$defs/strings"},
        "aliases": {"$ref": "#/$defs/strings"},
        "task_keywords": {"$ref": "#/$defs/strings"},
        "historical_status": {"type": ["object", "string", "array"]},
        "correction_refs": {"$ref": "#/$defs/references"},
        "gate_a": {"type": "object", "required": ["accepted"], "properties": {"accepted": {"type": "boolean"}}}
      },
      "additionalProperties": false
    }
  }
}
