                  "costs",
                  "failure_modes",
                  "use_when",
                  "avoid_when",
                  "implementation_notes",
                  "dst_klei_basis",
                  "case_evidence",
                  "counter_evidence",
                  "related_rules",
                  "related_anti_patterns",
                  "related_decision_trees",
