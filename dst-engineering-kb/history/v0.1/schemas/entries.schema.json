                  "authority": {
                    "type": "string"
                  },
                  "lifecycle": {
                    "type": "string"
                  },
                  "networking": {
                    "type": "string"
                  },
                  "persistence": {
                    "type": "string"
                  },
                  "performance": {
                    "type": "string"
                  },
                  "benefits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "costs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "failure_modes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "use_when": {
                    "type": "string"
                  },
                  "avoid_when": {
                    "type": "string"
                  },
                  "implementation_notes": {
                    "type": "string"
                  },
                  "dst_klei_basis": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "case_evidence": {
                    "type": "string"
                  },
                  "counter_evidence": {
                    "type": "string"
                  },
                  "related_rules": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
