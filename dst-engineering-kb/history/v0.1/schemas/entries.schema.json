{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DST Engineering KB 0.1 Entry Collection",
  "type": "object",
  "required": [
    "schema_version",
    "kb_title",
    "extraction",
    "created_at",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kb_title": {
      "type": "string"
    },
    "extraction": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "schema_version",
        "entry_type",
        "id",
        "title",
        "summary",
        "knowledge_kind",
        "tags",
        "scope",
        "evidence_level",
        "confidence",
        "sources",
        "related",
        "status",
        "created_from_case",
        "version",
        "details"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "entry_type": {
          "enum": [
            "source_fact",
            "case",
            "pattern",
            "rule",
            "anti_pattern",
            "decision",
            "failure_case",
            "correction",
            "test_case",
            "playbook"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "knowledge_kind": {
          "enum": [
            "Klei Fact",
            "Case Observation",
            "Engineering Pattern Candidate",
            "Engineering Rule Candidate",
            "Recommendation"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "evidence_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ]
        },
        "confidence": {
          "enum": [
            "Experimental",
            "Low",
            "Medium",
            "High",
            "Very High"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "locator",
              "note"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "candidate",
            "validated_single_case",
            "supported_by_klei",
            "needs_runtime_validation",
            "superseded",
            "corrected",
            "deprecated"
          ]
        },
        "created_from_case": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "runtime_records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "environment",
              "result",
              "artifact"
            ],
            "properties": {
              "environment": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "artifact": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "entry_type": {
                "const": "source_fact"
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "api_mechanism",
                  "observed_behaviour",
                  "source_file",
                  "relevant_function",
                  "source_locator",
                  "version_context",
                  "implication",
                  "do_not_infer"
                ],
                "properties": {
                  "api_mechanism": {
                    "type": "string"
                  },
                  "observed_behaviour": {
                    "type": "string"
                  },
                  "source_file": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "relevant_function": {
                    "type": "string"
                  },
                  "source_locator": {
                    "type": "string"
                  },
                  "version_context": {
                    "type": "string"
                  },
                  "implication": {
                    "type": "string"
                  },
                  "do_not_infer": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entry_type": {
                "const": "case"
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "case_id",
                  "name",
                  "mod_version",
                  "author",
                  "analysis_date",
                  "project_size",
                  "domains",
                  "research_rounds",
                  "analysis_file_count",
                  "runtime_tested",
                  "dedicated_tested",
                  "vanilla_context",
                  "project_hash",
                  "hash_algorithm",
                  "architecture_summary",
                  "observations",
                  "identified_patterns",
                  "identified_anti_patterns",
                  "confirmed_failure_cases",
                  "unverified",
                  "corrections",
                  "exclusions",
                  "availability_limit"
                ],
                "properties": {
                  "case_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "mod_version": {
                    "type": "string"
                  },
                  "author": {
                    "type": "object",
                    "required": [
                      "declared",
                      "source"
                    ],
                    "properties": {
                      "declared": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "analysis_date": {
                    "type": "string"
                  },
                  "project_size": {
                    "type": "object",
                    "required": [
                      "files",
                      "lua_files",
                      "bytes"
                    ],
                    "properties": {
                      "files": {
                        "type": "integer"
                      },
                      "lua_files": {
                        "type": "integer"
                      },
                      "bytes": {
                        "type": "integer"
                      }
                    },
                    "additionalProperties": false
                  },
                  "domains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "research_rounds": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "round",
                        "topic",
                        "availability"
                      ],
                      "properties": {
                        "round": {
                          "type": "integer"
                        },
                        "topic": {
                          "type": "string"
                        },
                        "availability": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "analysis_file_count": {
                    "type": "object",
                    "required": [
                      "unique_mod_total",
                      "confirmed_mod_lower_bound",
                      "count_note",
                      "project_lua_count_is_not_analysis_count"
                    ],
                    "properties": {
                      "unique_mod_total": {
                        "type": [
                          "null",
                          "integer"
                        ]
                      },
                      "confirmed_mod_lower_bound": {
                        "type": "integer"
                      },
                      "count_note": {
                        "type": "string"
                      },
                      "project_lua_count_is_not_analysis_count": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  "runtime_tested": {
                    "type": "boolean"
                  },
                  "dedicated_tested": {
                    "type": "boolean"
                  },
                  "vanilla_context": {
                    "type": "object",
                    "required": [
                      "source_context_id",
                      "release_build",
                      "note"
                    ],
                    "properties": {
                      "source_context_id": {
                        "type": "string"
                      },
                      "release_build": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "note": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "project_hash": {
                    "type": "string"
                  },
                  "hash_algorithm": {
                    "type": "string"
                  },
                  "architecture_summary": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "observations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "claim",
                        "knowledge_kind",
                        "evidence_level",
                        "source"
                      ],
                      "properties": {
                        "claim": {
                          "type": "string"
                        },
                        "knowledge_kind": {
                          "type": "string"
                        },
                        "evidence_level": {
                          "type": "string"
                        },
                        "source": {
                          "type": "object",
                          "required": [
                            "source_id",
                            "locator",
                            "note"
                          ],
                          "properties": {
                            "source_id": {
                              "type": "string"
                            },
                            "locator": {
                              "type": "string"
                            },
                            "note": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "identified_patterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "identified_anti_patterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "confirmed_failure_cases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "unverified": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "corrections": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "exclusions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "topic",
                        "reason"
                      ],
                      "properties": {
                        "topic": {
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "availability_limit": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entry_type": {
                "const": "pattern"
              }
            }
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "name",
                  "category",
                  "problem",
                  "context",
                  "forces",
                  "core_idea",
                  "structure",
                  "state_ownership",
                  "authority",
                  "lifecycle",
