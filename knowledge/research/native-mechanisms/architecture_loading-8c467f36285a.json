        "AttachClassified",
        "container_classified pending",
        "InitializeSlots",
        "RegisterNetListeners"
      ],
      "engineering_question": "容器replica先建或classified先到时如何补接，何时再次初始化槽会直接触发断言？",
      "knowledge_status": "research",
      "retrieval_status": "restricted",
