      "engineering_question": "寒冷累计何时进入冻结，融化中是否仍算冻结，组件移除与读档会恢复哪些状态？",
      "knowledge_status": "research",
      "retrieval_status": "restricted",
      "coding_status": "hold",
      "scope": {
        "source_epoch": "760944",
        "evidence": "local_archive_static_lua",
