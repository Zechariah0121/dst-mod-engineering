  "entries": [
    {
      "id": "EXP-CHAIN-SKILL-HUD-001",
      "title": "背包右键技能的权威结算与玩家专属资源 HUD 有限链",
      "aliases": [
        "UseItemFromInvTile",
        "INVENTORY",
        "dolongaction",
        "技能资源 HUD",
        "SetClassifiedTarget",
        "owner-only classified"
      ],
      "engineering_question": "怎样沿普通背包格鼠标右键与服务器执行帧，接入可拒绝、可取消、可保存的玩家资源，并让每个本地 HUD 在重建时读取当前状态？",
      "knowledge_status": "research",
      "retrieval_status": "restricted",
      "coding_status": "hold",
      "scope": {
        "source_epoch": "762172",
        "steam_buildid": "26474873",
        "runtime_verified": false,
        "evidence": "installed_archive_static_lua",
        "bounds": [
          "普通鼠标右键、无活动物品或强制修饰键，普通 Wilson SG，物品位于自己的主背包格，原版 Lua 未被第三方改写。",
          "展示服务器可自行绑定的原版 INVENTORY 动作路径。自定义动作、扣费、网络投影与 HUD 是边界明确的工程示例，客户端动作和 native transport 仍需实机验证。",
          "原版 inventory_classified 与 player_classified 仅按所列定向、父实体与状态桥接合同取证。示例每个分类实体对应一个玩家实体，重建按新实例附着。"
        ],
        "reused_entry_ids": [
          "EXP-CHAIN-SPELL-001",
          "EXP-ACT-001",
          "EXP-ACT-002",
          "EXP-LIFE-001",
          "EXP-UI-003",
          "N005-UI-C02",
          "AI-N001-10",
          "EXP-WORLD-003"
        ],
        "increment": "在地面空点 CASTSPELL、普通左键 PICK 和通用 Controls 重建之外，补普通背包格右键的真实输入、局部 RPC、候选重建、长动作提交及其 owner-only 资源 HUD 接线和保存。"
      },
      "claims": [
        {
          "id": "EXP-CHAIN-SKILL-HUD-001-C01",
          "kind": "NSF",
          "statement": "无强制修饰键的背包格 CONTROL_SECONDARY 按下由 InvSlot:OnControl 调用 UseItem，再交给 owner.replica.inventory。Replica 在本机有 inventory 组件时直接交 master，在远端走 inventory_classified。后者无活动物品时重算 INVENTORY 候选并取 actions[1]。GetMapTarget 成功时可提前开地图；选中普通非地图动作且 TryNonNetworkedAction 未处理时进入远端发送。",
          "evidence_refs": [
            "HUD-SLOT-CONTROL",
            "HUD-SLOT-USE",
            "HUD-INV-REPLICA",
            "HUD-INV-CLIENT",
            "HUD-PICKER",
            "HUD-SORT",
            "HUD-MAP-TARGET",
            "HUD-INV-NONNETWORKED"
          ]
        },
        {
          "id": "EXP-CHAIN-SKILL-HUD-001-C02",
          "kind": "NSF",
          "statement": "RemoteUseItemFromInvTile 在客户端无 locomotor 时发送 UseItemFromInvTile RPC；若定义了 pre_action_cb，则忙时提前返回，否则先运行该回调。本示例未定义 pre_action_cb。带 locomotor 的分支须满足 CanLocomote、非 WALKTO 与不忙，再用 preview_cb 发送。wilson_client 的 dolongaction 预演调用 PerformPreviewBufferedAction，后者通过 RemoteBufferedAction 调用该闭包。",
          "evidence_refs": [
            "HUD-PREVIEW-SEND",
            "HUD-PREVIEW-CALL",
            "HUD-DO-PREVIEW",
            "HUD-SG-CLIENT"
          ]
        },
        {
          "id": "EXP-CHAIN-SKILL-HUD-001-C03",
          "kind": "NSF",
          "statement": "UseItemFromInvTile RPC 检查参数形态，将 controlmods 解码到 playercontroller，调用 inventory:UseItemFromInvTile(item, action, mod_name)，随后清控制修饰。服务端要求不忙且 CanAccessItem，重收候选后在非地图分支匹配首项的 code 与 mod_name；CanAccessItem 也允许打开的非只读容器，示例若要限主背包格需执行时查独立槽位。",
          "evidence_refs": [
            "HUD-INV-RPC",
            "HUD-INV-SERVER",
            "HUD-GET-SLOT"
          ]
        },
        {
          "id": "EXP-CHAIN-SKILL-HUD-001-C04",
          "kind": "NSF",
          "statement": "原版 wilson 的 dolongaction 默认一秒超时，退出与否由状态图负责。超时执行 PerformBufferedAction。退出时在缓冲仍为本态动作且没有匹配的 lastheldaction 时清除缓冲。BufferedAction:Do 先复验 IsValid，再调用 Action.fn 并据返回触发成功或失败。",
          "evidence_refs": [
            "HUD-SG-SERVER",
            "HUD-CLEAR",
            "HUD-BUFFERED",
            "HUD-PERFORM"
          ]
        },
        {
          "id": "EXP-CHAIN-SKILL-HUD-001-C05",
          "kind": "NSF",
          "statement": "原版 inventory Replica 在 master 生成 inventory_classified 并设 player 父实体；OnOpen 将 classified target 设为玩家，OnClose 指向 classified 自身。inventory_classified 在客户端 OnEntityReplicated 通过 GetParent 接回玩家，已有 Replica 则尝试附着，否则保留临时引用。player_classified 同样按父实体附着，master 的 setowner 将它定向到玩家。",
          "evidence_refs": [
            "HUD-INV-OPEN",
            "HUD-INV-SPAWN",
            "HUD-INV-ATTACH",
            "HUD-PLAYER-SETOWNER",
            "HUD-PLAYER-ATTACH"
          ]
        },
        {
          "id": "EXP-CHAIN-SKILL-HUD-001-C06",
          "kind": "NSF",
          "statement": "netvars.lua 记载相同实体在两端须按相同定义声明字段，set 在值变化时触发 dirty，value 读取当前快照。原版 player_classified 初始状态同步及 isghostmodedirty 最终都可调用 owner:SetGhostMode，再转给 Controls；PlayerHud 创建 Controls，Widget:Kill 移除 widget 实体，EntityScript:Remove 清除事件订阅。",
          "evidence_refs": [
            "HUD-NET",
            "HUD-PLAYER-GHOST",
            "HUD-PLAYER-INITIAL",
            "HUD-GHOST-CONTROLS",
            "HUD-HUD-CTOR",
            "HUD-WIDGET",
            "HUD-ENTITY-REMOVE",
            "HUD-PLAYER-GHOST-LISTEN",
            "HUD-PLAYER-INIT-CALL",
            "HUD-CONTROLS-GHOST"
          ]
        },
        {
          "id": "EXP-CHAIN-SKILL-HUD-001-C07",
          "kind": "NSF",
          "statement": "SerializeUserSession 要求玩家具有非空 userid，且玩家为本地玩家或当前端为服务端；它调 GetSaveRecord，再向 TheNet 提交文本。GetPersistData 采集组件 OnSave 返回的非空表，恢复路径调用 SetPersistData 并将保存键交给已装配的相应组件 OnLoad。示例表内只有一个数值。",
          "evidence_refs": [
            "HUD-SESSION",
            "HUD-GET-RECORD",
            "HUD-PERSIST-SAVE",
            "HUD-PERSIST-LOAD",
            "HUD-SESSION-LOAD"
          ]
        },
        {
          "id": "EXP-CHAIN-SKILL-HUD-001-C08",
          "kind": "REC",
          "statement": "示例在 Action 执行时复验当前缓冲、玩家、物品及主背包归属，成功构造短效 FX 且回调未取消后再扣费。以独立定向 classified 传一个预留 0 的快照字段，Widget 每次订阅后主动读取，并由分类实体附着、dirty 与移除触发刷新；HUD Kill 负责它自己的事件订阅退出。",
          "evidence_refs": [
            "HUD-PERFORM",
            "HUD-SPAWN-CALLBACK",
            "HUD-INV-OPEN",
            "HUD-NET",
            "HUD-WIDGET",
            "HUD-ENTITY-REMOVE",
