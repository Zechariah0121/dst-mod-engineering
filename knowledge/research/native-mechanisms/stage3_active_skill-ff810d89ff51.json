        "bounds": [
          "普通人形玩家，装备yellowstaff，地面空点鼠标右键，无活动物品/特殊右键覆盖，无第三方覆写。",
          "主链预测客户端与master，非预测发送位置仅核静态分支。",
          "闭合到星体独立生命周期及组件保存/加载，热/烹饪/理智范围公式排除。"
        ],
        "reused_entry_ids": [
