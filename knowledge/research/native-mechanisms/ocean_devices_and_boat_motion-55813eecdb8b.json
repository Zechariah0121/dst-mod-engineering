        {
          "id": "EXP-OCEAN-002-C02",
          "kind": "NSF",
          "statement": "ApplyRowForce按当前速度与归一输入方向的点积分流。正向分量使用随当前速度/max_velocity变化的easing阻尼，侧向使用基础force dampening；非正向支路直接使用传入dir_x/z乘力。DoApplyForce累加velocity_x/z并裁到MAX_ALLOWED_VELOCITY。max_velocity参与正向阻尼计算。",
          "evidence_refs": [
            "OC-S14"
