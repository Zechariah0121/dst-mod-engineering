          "evidence_refs": [
            "OC-S23",
            "OC-S24",
            "OC-S25"
          ]
        },
        {
          "id": "EXP-OCEAN-003-C04",
          "kind": "NSF",
          "statement": "AddEmergencyBrakeSource把source以固定stoprightthere键写入布尔SourceModifierList，随后设halting=true并把船Physics质量置0。Remove以同一身份移除并按剩余列表重算halting，全部来源消失才把质量设回TUNING.BOAT.MASS。OnUpdate在halting时把本次提交motor的局部向量/局部速度清0，所存velocity_x/z仍按前面步骤计算。",
          "evidence_refs": [
            "OC-S21",
            "OC-S26",
            "OC-S29",
            "OC-S16"
          ]
        },
