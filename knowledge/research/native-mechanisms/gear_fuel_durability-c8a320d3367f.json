          "source_file": "scripts/components/fueled.lua",
          "visibility": "require 导出的组件类实例方法；方法体没有自行检查执行端。",
          "parameters": [
            "item 为交给本次消费的燃料实体，可为 nil。",
            "doer 可选；item 为 nil 时 doer 需具备 fuel/fueler 契约。"
          ],
          "returns": "接收成功返回true；拒绝隐式nil。成功值只表达该接受与消费路径。",
          "preconditions": [
            "accepting 为真且 fuel_obj 拥有 fuel 或 fueler，并匹配 primary/secondary fueltype。",
            "item 形态由调用方决定，直接传完整堆叠会在本方法 Remove 整个传入实体。",
            "可选 cantakefuelitemfn(inst,item,doer) 决定进一步允许。"
          ],
          "side_effects": [
            "按 fuelvalue*bonusmult*mult*wetmult*masterymult 得投入量并 DoDelta。",
            "multfn(self.inst,fuel_obj) 真值返回用作倍数，nil/false回退1；fuelmaster 的 bonusfn 接收 doer,item,target。",
