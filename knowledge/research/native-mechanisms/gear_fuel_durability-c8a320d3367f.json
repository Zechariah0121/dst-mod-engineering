        },
        {
          "symbol": "Repairable:NeedsRepairs",
          "source_file": "scripts/components/repairable.lua",
          "visibility": "require 导出的组件类实例方法；方法体没有自行检查执行端。",
          "parameters": [],
          "returns": "按 health、workable、perishable、finiteuses 的分支顺序检查低于0.95，其他false；workable还要求 workable。",
          "preconditions": [
            "对应分支的组件与最大值合法。"
          ],
          "side_effects": [],
          "lifecycle": "原版 ANNOUNCE_CANFIX 文案消费者使用；实际 Repair 的满量门槛另行计算。",
          "evidence_refs": [
            "GEAR-S29",
            "GEAR-S37",
            "GEAR-S30"
          ],
          "unknowns": []
        },
        {
          "symbol": "Repairable:SetFiniteUsesRepairable",
          "source_file": "scripts/components/repairable.lua",
          "visibility": "require 导出的组件类实例方法；方法体没有自行检查执行端。",
          "parameters": [
            "repairable 按 truthiness 设置当前有限次数可维修状态。"
          ],
          "returns": "无显式返回值。",
          "preconditions": [
            "目标已经有 repairable。",
            "初始状态或 finiteuses 属性钩子向本组件提供 current<total。"
          ],
          "side_effects": [
            "写 finiteusesrepairable，经属性钩子添加或移除 finiteusesrepairable 标签。"
          ],
          "lifecycle": "finiteuses current/total 变化驱动；添加组件时若数值已经受损，要核对该状态是否初始化。",
          "evidence_refs": [
            "GEAR-S28",
            "GEAR-S01"
          ],
          "unknowns": []
        }
      ],
      "mechanism_steps": [
        {
          "step": 1,
          "description": "配置目标 MATERIALS 类型和材料 repairer 正值次数，建立菜单需要的匹配标签。",
          "evidence_refs": [
            "GEAR-S28",
            "GEAR-S31",
            "GEAR-S34",
            "GEAR-S35"
          ]
        },
        {
          "step": 2,
          "description": "当前有限次数变化使目标 finiteusesrepairable 更新；右键菜单按标签与实际姿态挑选动作。",
          "evidence_refs": [
            "GEAR-S01",
            "GEAR-S32"
          ]
        },
        {
          "step": 3,
          "description": "服务器 REPAIR 选材料并调用 Repair，按自己的检验函数和实际数值再判定。",
          "evidence_refs": [
            "GEAR-S33",
            "GEAR-S30",
            "GEAR-S29"
          ]
        },
        {
          "step": 4,
          "description": "先修复耐久，再消费一件材料，最后执行反馈回调；保存继续走原有限次数组件。",
          "evidence_refs": [
            "GEAR-S30",
            "GEAR-S36",
            "GEAR-S03"
          ]
        }
      ],
      "unknowns": [
        "本条覆盖普通 repairable；forge 套件、护甲与缝纫组件继续按现有指南和具体原版消费者选择。",
        "操作者权限属于目标功能设计；testvalidrepairfn/checkmaterialfn 均未接收 doer，需要权限时在具有操作者的真实入口落实。",
