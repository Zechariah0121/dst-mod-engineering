        "Controls postconstruct",
        "HUD 重建",
        "MakeScalingNodes",
        "HUD scale"
      ],
      "engineering_question": "本地玩家 HUD 创建或替换后，怎样把小控件接到新实例并复用现成布局缩放，避免用完整 HUD 初始化充当刷新？",
      "knowledge_status": "research",
      "retrieval_status": "restricted",
      "coding_status": "hold",
      "scope": {
        "source_epoch": "DST scripts 762172 / Steam build 26474873",
        "audience": "本地客户端 UI，包括有本地玩家 HUD 的主机",
        "boundary": "具名 Lua 调用链的静态契约；实例上第三方覆写需重新核对",
        "runtime_verified": false
      },
      "claims": [
        {
          "id": "EXP-UI-003-C01",
          "kind": "NSF",
          "statement": "ActivateHUD 每次新建 PlayerHud，先 PushScreen，必要时聚焦，设置相机更新回调，再 SetMainCharacter(inst)。OnSetOwner 只在本地玩家且 HUD 为空时进入本地 HUD 安装分支，seamless-swap 目标延后到 ActivatePlayer 的交换分支创建新 HUD。DeactivateHUD PopScreen(inst.HUD) 后清玩家 HUD 字段。",
          "evidence_refs": [
            "UI-S19",
            "UI-S25",
            "UI-S26"
          ]
        },
        {
          "id": "EXP-UI-003-C02",
          "kind": "NSF",
          "statement": "SetMainCharacter(maincharacter) 仅在参数为真时执行，先写 maincharacter.HUD 和 self.owner，再 CreateOverlays，向 self.root AddChild 新的 Controls(owner)，然后为 owner 登记多个匿名监听、初始化 sanity 显示并对存在的 overflow Close/Open。该方法没有先 Kill 旧 controls 或解绑上一次 owner 的这些监听。",
          "evidence_refs": [
            "UI-S20"
          ]
        },
        {
          "id": "EXP-UI-003-C03",
          "kind": "NSF",
          "statement": "CreateOverlays 的入口只 KillAllChildren 于 overlayroot、under_root、over_root，SetMainCharacter 中的 Controls 挂在 root。Controls 构造保存传入 owner，构造过程中调用 MakeScalingNodes。AddClassPostConstruct 保存并先调用原构造，再把相同 self 和其余参数传给 postfn。",
          "evidence_refs": [
            "UI-S27",
            "UI-S20",
            "UI-S21",
            "UI-S22",
            "UI-S28"
          ]
        },
        {
          "id": "EXP-UI-003-C04",
          "kind": "EI",
          "statement": "SetMainCharacter 的 self.controls 赋值要在 Controls(self.owner) 求值完成后才执行，postconstruct 也发生在该构造调用返回之前。因此构造 hook 内应使用传入的 Controls 实例；此时 owner.HUD.controls 可能仍为空或仍指向旧对象。",
          "evidence_refs": [
            "UI-S20",
            "UI-S28"
          ]
        },
        {
          "id": "EXP-UI-003-C05",
          "kind": "NSF",
          "statement": "MakeScalingNodes 建立带屏幕锚点、比例缩放和最大放大的节点，再建立用户 HUD 缩放子节点并改写 top_root 等字段。SetHUDSize 对这些具名节点应用 HUD scale，对左右节点依 Player1 分配 crafting scale，按平台/分屏条件调整 commandwheel，对存在的 desync 设缩放，最后向 owner.HUD.inst 发 refreshhudsize。Controls 构造会调用它，OnUpdate 在屏幕尺寸变化时再次调用。",
          "evidence_refs": [
            "UI-S23",
            "UI-S24",
            "UI-S35",
            "UI-S36"
          ]
        },
        {
          "id": "EXP-UI-003-C06",
          "kind": "REC",
          "statement": "本地 HUD 小控件优先在 widgets/controls 的 postconstruct 内按传入 owner 挂到本次 Controls 的合适缩放节点。每个新实例创建自己的控件及回调，实例字段保存本次对象；全局只登记构造 hook。静态内容无需再建立轮询器或全局控件管理器。",
          "evidence_refs": [
            "UI-S20",
            "UI-S21",
            "UI-S22",
            "UI-S23",
            "UI-S24",
            "UI-S28"
          ]
        },
        {
          "id": "EXP-UI-003-C07",
          "kind": "REC",
          "statement": "已有控件的数据刷新用自己的 setter/getter 与必要订阅完成。完整 SetMainCharacter 适合作为本来源中的新 HUD 初始化调用；需要同一 HUD 换 owner 的项目应专门设计旧绑定退出与新绑定进入。独立弹窗按保存实例随 Controls 退出关闭，HUD 普通子控件继续沿基类 Kill 链清理。",
          "evidence_refs": [
            "UI-S20",
            "UI-S19",
            "UI-S05",
            "UI-S29",
            "UI-S01",
            "UI-S02"
          ]
        }
