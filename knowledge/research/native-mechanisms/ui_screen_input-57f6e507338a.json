        "boundary": "具名 Lua 调用链的静态契约；实例上第三方覆写需重新核对",
        "runtime_verified": false
      },
      "claims": [
        {
          "id": "EXP-UI-002-C01",
          "kind": "NSF",
          "statement": "Input:OnControl 在鼠标条件允许且 FrontEnd 返回非真值时才分发特定 control 与 general oncontrol。FrontEnd 的普通栈路径先对 PRIMARY 映射 ACCEPT，并在特定文字处理条件之后调用栈顶 OnControl；栈顶消费时返回 true。PlayerController:Activate 为本地 ThePlayer 注册 general-control 消费者。",
          "evidence_refs": [
            "UI-S08",
            "UI-S09",
            "UI-S17"
          ]
        },
        {
          "id": "EXP-UI-002-C02",
          "kind": "NSF",
          "statement": "Widget:OnControl 要求自身 focus，仅遍历 focus 为真的子控件并在子控件返回真值时消费；未消费的滚轮 control 可转给 parent_scroll_list，最后返回 false。该方法本身没有 shown 或 enabled 门禁。",
          "evidence_refs": [
            "UI-S10"
          ]
        },
        {
          "id": "EXP-UI-002-C03",
          "kind": "NSF",
          "statement": "Button:OnControl 先执行基类分发，再要求 IsEnabled、focus 以及 selected 许可；匹配 control 和 mouseonly 条件后，首次 down 保存位置、置 down、触发 ondown，up 仅在先前 down 时复位并调用 onclick。匹配分支即使 up 没有对应 down 也返回 true。SetControl(PRIMARY) 存 ACCEPT 并设 mouseonly。",
          "evidence_refs": [
            "UI-S11",
            "UI-S32"
          ]
        },
        {
          "id": "EXP-UI-002-C04",
          "kind": "NSF",
          "statement": "Button:OnLoseFocus 与 OnDisable 会撤销尚未释放的 down、还原点击位置并停止更新。Widget:Hide 仅改变显示状态并调用 OnHide；Widget:IsEnabled 只检查 enabled 及父链。故自定义隐藏路径需要结合自己的焦点和输入策略。",
          "evidence_refs": [
            "UI-S12",
            "UI-S33",
            "UI-S32"
          ]
        },
        {
          "id": "EXP-UI-002-C05",
          "kind": "NSF",
          "statement": "ControllerFunctionsFromButtons 返回 OnControl 和 GetHelpText 两个闭包。它会检查所有按钮是否已配置 controller_control，全部未配置且按钮多于一个时才把最后按钮设为 CANCEL；按下返回 false，释放匹配时执行 cb 并返回 true。MENU_START 仅允许在控制器已连接时走这条按钮匹配。PopupDialogScreen 先调用基类，再调用此闭包。",
          "evidence_refs": [
            "UI-S13",
            "UI-S14"
          ]
        },
        {
          "id": "EXP-UI-002-C06",
          "kind": "REC",
          "statement": "简单 PopupDialogScreen 明确给关闭按钮设置 controller_control=CANCEL，尤其只有一个按钮时；扩展已有 OnControl 先保留旧返回，处理自有 control 后返回 true，其余保留原行为。需要按放交互时优先让 Button 处理配对，业务回调放 onclick。",
          "evidence_refs": [
            "UI-S11",
            "UI-S12",
            "UI-S13",
            "UI-S14"
          ]
        },
        {
          "id": "EXP-UI-002-C07",
          "kind": "REC",
          "statement": "常驻内嵌面板被隐藏而仍存活时，关闭入口可显式 ClearFocus，并按功能把焦点交回当前入口控件；原版 Controls:OnUpdate 隐藏 mapcontrols 时也对其已有 focus 显式 ClearFocus。全局 raw-key 回调适合观察快捷键；如果功能需要上游消费，接入当前 Screen/control 路径，并遵守已有文字处理与焦点规则。",
          "evidence_refs": [
            "UI-S06",
            "UI-S10",
            "UI-S15",
            "UI-S16",
            "UI-S33",
            "UI-S35"
          ]
        }
      ],
