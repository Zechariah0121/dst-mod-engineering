{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Native AI Knowledge 1.0",
  "type": "object",
  "required": ["schema_version", "track_id", "version", "canonical_status", "default_projection_fields", "entries"],
  "properties": {
    "schema_version": {"const": "native-ai-1.0"},
    "track_id": {"const": "NATIVE-001"},
    "version": {"const": "1.0.0"},
    "canonical_status": {"const": "CANONICAL"},
    "default_projection_fields": {"const": ["id", "title", "engineering_question", "native_fact", "scope", "ai_coding_impact", "common_ai_failure", "recommended_reasoning", "does_not_mean", "evidence_strength"]},
    "default_cap": {"enum": [1, 2, 3, 4, 5]},
    "default_core_cap": {"const": 5},
    "default_core_per_task_max": {"enum": [1, 2, 3, 4, 5]},
    "evidence_class_contract": {"type": "object"},
    "entries": {"type": "array", "minItems": 13, "items": {"$ref": "#/$defs/entry"}}
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "entry_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AI-N001-(0[1-9]|1[0-3])$"}},
    "entry": {
      "type": "object",
      "required": ["id", "title", "engineering_question", "native_fact", "scope", "ai_coding_impact", "common_ai_failure", "recommended_reasoning", "does_not_mean", "evidence_strength", "typical_mod_tasks", "retrieval_triggers", "knowledge_role", "coverage_status", "related_native_facts", "typed_relations", "research_evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^AI-N001-(0[1-9]|1[0-3])$"},
        "title": {"type": "string"},
        "engineering_question": {"type": "string"},
        "native_fact": {
          "type": "object",
          "required": ["claim_type", "statement"],
          "properties": {"claim_type": {"const": "NSF"}, "statement": {"type": "string"}},
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "required": ["snapshot_id", "version", "sides", "runtime_environments", "exclusions"],
          "properties": {"snapshot_id": {"type": "string"}, "version": {"type": "string"}, "sides": {"type": "string"}, "runtime_environments": {"type": "string"}, "exclusions": {"$ref": "#/$defs/strings"}},
          "additionalProperties": false
        },
        "ai_coding_impact": {
          "type": "object",
          "required": ["claim_type", "decisions"],
          "properties": {"claim_type": {"const": "REC / EI"}, "decisions": {"$ref": "#/$defs/strings"}},
          "additionalProperties": false
        },
        "common_ai_failure": {"$ref": "#/$defs/strings"},
        "recommended_reasoning": {
          "type": "object",
          "required": ["claim_type", "steps"],
          "properties": {"claim_type": {"const": "REC"}, "steps": {"$ref": "#/$defs/strings"}},
          "additionalProperties": false
        },
        "does_not_mean": {"$ref": "#/$defs/strings"},
        "evidence_strength": {"const": {"native_fact": "DIRECT_STATIC_SOURCE_IN_EXISTING_SNAPSHOT", "engineering_recommendation": "BOUNDED_REASONING_FROM_SOURCE_AND_TASK_REQUIREMENTS", "effect_on_AI_quality": "PER_ENTRY_CAUSAL_EFFECT_NOT_ESTABLISHED"}},
        "typical_mod_tasks": {"$ref": "#/$defs/strings"},
        "retrieval_triggers": {"$ref": "#/$defs/strings"},
        "knowledge_role": {"type": "string"},
        "coverage_status": {"type": "string"},
        "related_native_facts": {"$ref": "#/$defs/entry_ids"},
        "typed_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "target"],
            "properties": {"type": {"const": "related"}, "target": {"type": "string", "pattern": "^AI-N001-(0[1-9]|1[0-3])$"}},
            "additionalProperties": false
          }
        },
        "research_evidence_refs": {"$ref": "#/$defs/entry_ids"},
        "default_retrieval_topic_gate": {"$ref": "#/$defs/strings"},
        "default_retrieval_role": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
