{
  "contract_version": "1",
  "tools": [
    {
      "name": "search_kb",
      "description": "Discover current public knowledge across four families and registered task guides. Default reviewer reading returns relevant complete original body objects with Scope, corrections and independent source state. Explicit projection=coding or mode=coding retains legacy admission. scope_logic combines supported explicit filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "top_k": {
            "type": "integer",
            "maximum": 30
          },
          "mode": {
            "type": "string",
            "enum": [
              "coding",
              "architect",
              "implement",
              "review",
              "debug",
              "research",
              "kb_curator"
            ]
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "reviewer"
          },
          "view": {
            "type": "string",
            "enum": [
              "decision",
              "reviewer",
              "evidence"
            ],
            "default": "decision"
          },
          "scope_logic": {
            "type": "string",
            "enum": [
              "and",
              "or"
            ],
            "default": "and"
          },
          "entry_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtime_environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "knowledge_statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrieval_statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coding_statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Explicit legacy source-verified environment. Omit to read current public package independently of source preparation."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "lookup_api",
      "description": "Navigate authored API identities across all families by default. Qualified identities match their complete owner; bare names group symbol/owner/file/visibility without merging file-local and exported identities. Supports require(\"module\").field. Use each executable followup to read its complete contract; navigation does not establish a public API or current behavior.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "top_k": {
            "type": "integer",
            "maximum": 30
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "reviewer"
          },
          "view": {
            "type": "string",
            "enum": [
              "decision",
              "reviewer",
              "evidence"
            ],
            "default": "decision"
          },
          "family": {
            "type": "string",
            "enum": [
              "legacy",
              "native_mechanism",
              "all",
              "native_ai",
              "native_core"
            ],
            "default": "all"
          },
          "owner": {
            "type": "string",
            "maxLength": 256
          },
          "identity_kind": {
            "type": "string",
            "enum": [
              "component_method",
              "method",
              "module_export",
              "file_local",
              "environment_member",
              "global",
              "qualified_member",
              "unknown"
            ]
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 64000,
            "default": 24000
          },
          "source_file": {
            "type": "string",
            "maxLength": 512,
            "description": "Exact original scripts/...lua path; use it to disambiguate same-name declarations in different files."
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Explicit legacy source-verified environment. Omit to read current public package independently of source preparation."
          }
        },
        "required": [
          "symbol"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_entry",
      "description": "Read a current public knowledge or guide ID without source preparation. Default reviewer preserves complete Scope, corrections and typed owner objects. Follow content-bound continuation unchanged, or select a relative JSON pointer. Explicit coding or source_epoch retains the legacy source-verified contract.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "reviewer"
          },
          "view": {
            "type": "string",
            "enum": [
              "decision",
              "reviewer",
              "evidence"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "review"
            ]
          },
          "cursor": {
            "type": "string",
            "maxLength": 2000
          },
          "pointer": {
            "type": "string",
            "maxLength": 2000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 64000
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Explicit legacy source-verified environment. Omit to read current public package independently of source preparation."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "resolve_evidence",
      "description": "Read one evidence reference for a knowledge ID, optionally narrowed by a relative JSON subpointer. Defaults to Reviewer navigation. Returns the selected evidence with its locator, hash and delivery metadata under max_bytes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reference_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999,
            "default": 0
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "reviewer"
          },
          "subpointer": {
            "type": "string",
            "maxLength": 2000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 24000,
            "default": 24000
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Explicit legacy source-verified environment. Omit to read current public package independently of source preparation."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_related",
      "description": "Traverse typed relations in the chosen direction. Related Source or Claim nodes are navigation leads; inspect their evidence and Scope.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "relation_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depth": {
            "type": "integer",
            "maximum": 30
          },
          "entry_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "both",
              "outgoing",
              "incoming"
            ]
          },
          "limit": {
            "type": "integer",
            "maximum": 30
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "reviewer"
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Explicit legacy source-verified environment. Omit to read current public package independently of source preparation."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
