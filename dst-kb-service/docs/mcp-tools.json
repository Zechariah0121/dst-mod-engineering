            "default": "reviewer"
          },
          "subpointer": {
            "type": "string",
            "maxLength": 2000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 24000,
            "default": 24000
          },
          "source_epoch": {
            "type": "string",
