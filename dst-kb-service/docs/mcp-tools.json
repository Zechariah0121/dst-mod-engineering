{
  "contract_version": "1",
  "tools": [
    {
      "name": "search_kb",
      "description": "Search ranked DST engineering knowledge across registered families. For code review or native API research use projection=reviewer, view=decision, then expand useful IDs. Results retain whole original atoms, Scope and evidence. scope_logic=and intersects filter dimensions; or unions them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "top_k": {
            "type": "integer"
          },
          "mode": {
            "type": "string",
            "enum": [
              "coding",
              "architect",
              "implement",
              "review",
              "debug",
              "research",
              "kb_curator"
            ]
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "coding"
          },
          "view": {
            "type": "string",
            "enum": [
              "decision",
              "reviewer",
              "evidence"
            ],
            "default": "decision"
          },
          "scope_logic": {
            "type": "string",
            "enum": [
              "and",
              "or"
            ],
            "default": "and"
          },
          "entry_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtime_environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "knowledge_statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retrieval_statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coding_statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tracks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Configured service environment; omit for default 759671. Reuse when expanding results. Each record retains its own source Scope."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "lookup_api",
      "description": "Look up an exact API identity. Explicit family=all with projection=reviewer navigates all four families and returns executable complete-object review calls, preserving source ambiguity and evidence limits. Default family=legacy finds preserved physical declarations and mapped claims; contract_delivery reports whether behavior claims were delivered. Explicit family=native_mechanism requires projection=reviewer and returns complete research API atoms under max_bytes. Use source_file to disambiguate sources; owner and identity_kind narrow native_mechanism only. Bare names and qualified identities such as require(\"module\").field are supported; signatures and dynamic expressions are not. File-local functions retain their visibility. A declaration or catalog gap alone does not establish a method contract, public API or absence. Defaults to reviewer projection and compact decision view.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "top_k": {
            "type": "integer"
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "reviewer"
          },
          "view": {
            "type": "string",
            "enum": [
              "decision",
              "reviewer",
              "evidence"
            ],
            "default": "decision"
          },
          "family": {
            "type": "string",
            "enum": [
              "legacy",
              "native_mechanism",
              "all"
            ],
            "default": "legacy"
          },
          "owner": {
            "type": "string",
            "maxLength": 256
          },
          "identity_kind": {
            "type": "string",
            "enum": [
              "component_method",
              "method",
              "module_export",
              "file_local",
              "environment_member",
              "global",
              "qualified_member",
              "unknown"
            ]
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 64000,
            "default": 24000
          },
          "source_file": {
            "type": "string",
            "maxLength": 512,
            "description": "Exact original scripts/...lua path; use it to disambiguate same-name declarations in different files."
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Configured service environment; omit for default 759671. Reuse when expanding results. Each record retains its own source Scope."
          }
        },
        "required": [
          "symbol"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_entry",
      "description": "Read a selected knowledge ID. Explicit purpose=review with projection=reviewer reads complete original objects across all four families under max_bytes. Follow continuation.arguments unchanged for content-bound paging, or select a record-relative pointer. Typed owner atoms and required Scope remain whole. view=decision is compact; reviewer adds detail; evidence adds source navigation. Omitting view preserves the legacy response. projection controls admission independently. For mechanism research, pointer selects a whole typed atom and max_bytes bounds delivery.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "coding"
          },
          "view": {
            "type": "string",
            "enum": [
              "decision",
              "reviewer",
              "evidence"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "review"
            ]
          },
          "cursor": {
            "type": "string",
            "maxLength": 2000
          },
          "pointer": {
            "type": "string",
            "maxLength": 2000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 64000
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Configured service environment; omit for default 759671. Reuse when expanding results. Each record retains its own source Scope."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "resolve_evidence",
      "description": "Read one evidence reference for a knowledge ID, optionally narrowed by a relative JSON subpointer. Defaults to Reviewer navigation. Returns the selected evidence with its locator, hash and delivery metadata under max_bytes.",
