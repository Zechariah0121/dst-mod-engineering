{
  "contract_version": "1",
  "tools": [
    {
      "name": "search_kb",
      "description": "Use for DST engineering knowledge search. Returns ranked summaries with evidence, scope and match reasons; not full text. Not for gameplay advice.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "top_k": {
            "type": "integer"
          },
          "mode": {
            "type": "string",
            "enum": [
              "architect",
              "implement",
              "review",
              "debug",
              "research",
              "kb_curator"
            ]
          },
          "entry_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtime_environments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_entry",
      "description": "Read a canonical knowledge ID in full, with source registry and correction warnings. Read scope before important engineering decisions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_related",
      "description": "Traverse typed relations with explicit edge direction. Source/Claim nodes may be returned. No assertion that a related node proves another.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "relation_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depth": {
            "type": "integer"
          },
          "entry_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "direction": {
            "type": "string",
            "enum": [
              "both",
              "outgoing",
              "incoming"
            ]
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_klei_facts",
      "description": "Search only Klei source facts for DST engine/API behavior. Snapshot scoped; never substitute case observations for vanilla API evidence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "top_k": {
            "type": "integer"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_tests",
      "description": "Find applicable DST test candidates by query or related entry IDs. Returned tests may be unexecuted; inspect their status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "entry_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "top_k": {
            "type": "integer"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_context_bundle",
      "description": "Use at start of a substantial DST architecture, coding, review, debug or research task. Returns a bounded relevant bundle, not the whole KB. Not for game strategy or lore.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_description": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "architect",
              "implement",
              "review",
              "debug",
              "research",
              "kb_curator"
            ]
          },
          "budget": {
            "type": "string",
            "enum": [
              "compact",
              "normal",
              "deep"
            ]
          }
        },
        "required": [
          "task_description"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "validate_kb",
      "description": "Maintenance/curator only: verify current KB schema, index, sources, relations and manifest. Do not run on every ordinary coding request.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}