    {
      "name": "get_context_bundle",
      "description": "Select public knowledge and guide body objects for a task, preserving Scope and evidence limits. compact/normal/deep bound the whole response at 16000/32000/64000 bytes. Default reviewer uses current public package; explicit coding uses legacy admission.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_description": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "coding",
              "architect",
              "implement",
              "review",
              "debug",
              "research",
              "kb_curator"
            ]
          },
          "budget": {
            "type": "string",
            "enum": [
              "compact",
              "normal",
              "deep"
            ]
          },
          "projection": {
            "type": "string",
            "enum": [
              "coding",
              "reviewer"
            ],
            "default": "reviewer"
          },
          "view": {
            "type": "string",
            "enum": [
              "decision",
              "reviewer",
              "evidence"
            ],
            "default": "decision"
          },
          "source_epoch": {
            "type": "string",
            "maxLength": 160,
            "description": "Explicit legacy source-verified environment. Omit to read current public package independently of source preparation."
          }
        },
        "required": [
          "task_description"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
